# Database — Prisma Postgres (Prisma Accelerate or direct connection)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_ACCELERATE_API_KEY"
# For direct Postgres: DATABASE_URL="postgresql://user:password@localhost:5432/capo"

# Better Auth
# Better Auth lee BETTER_AUTH_SECRET, con fallback a AUTH_SECRET.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="https://tudominio.com" # o http://localhost:3000

# GitHub OAuth
# https://github.com/settings/apps
AUTH_GITHUB_ID="your_github_oauth_app_client_id"
AUTH_GITHUB_SECRET="your_github_oauth_app_client_secret"

# URL pública del sitio (para metadata / Open Graph). Sin barra final.
NEXT_PUBLIC_APP_URL="https://tudominio.com"

# Sentry (error tracking) — DSN del proyecto en sentry.io - mismo valor para ambas
NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxx@oXXXXXXX.ingest.us.sentry.io/XXXXXXX"
SENTRY_DSN="https://xxxxxxxx@oXXXXXXX.ingest.us.sentry.io/XXXXXXX"
